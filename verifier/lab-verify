def kms_degraded(signed, checked_by=""):
    return KMS_DEGRADED % (signed["metadata"].get("kms_key_arn"), checked_by)
DEGRADED_MLDSA87 = (
    "DEGRADED (lab): ML-DSA-87 signature NOT CHECKED by this verifier "
    "(the stdlib has no ML-DSA; G-212)"
)


def _no_dupes(pairs):
    seen = {}
    for k, v in pairs:
        if k in seen:
            raise ValueError("duplicate member %r" % k)
        seen[k] = v
    return seen


def _no_constant(name):
    raise ValueError("%s is not JSON (RFC 8259 section 6)" % name)


def _finite_float(lexeme):
    value = float(lexeme)
    if value in (float("inf"), float("-inf")):  # 1e400: a valid lexeme, never an infinite float here
        raise ValueError("a number outside the double range (RFC 8259 section 9 limit)")
    return value


MAX_DEPTH = 64  # containers; the 65th is refused (requisition-ts src/json.ts MAX_DEPTH; lab_key_rule.ex decode_bounded/1)
MAX_INTEGER = 9_007_199_254_740_991  # CanonicalPayload v3's integer range (canonical.MAX_INTEGER)


def _check_depth(text):
    depth, in_string, escaped = 0, False, False
    for ch in text:
        if in_string:
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                in_string = False
        elif ch == '"':
            in_string = True
        elif ch in "[{":
            depth += 1
            if depth > MAX_DEPTH:
                raise ValueError("nesting deeper than %d" % MAX_DEPTH)
        elif ch in "]}":
            depth -= 1


def _bounded_int(lexeme):
    value = int(lexeme)
    if not -MAX_INTEGER <= value <= MAX_INTEGER:
        raise ValueError("an integer outside +-(2^53-1), the canonical form's range")
    return value


def loads_strict(data):
    """requisition_aws.client.loads_strict's rule, copied (this file runs under -I and cannot import the package):
    duplicate members, NaN/Infinity/-Infinity and numbers that are not finite doubles refused; bytes decoded as
    strict UTF-8 (no UTF-16/32 detection, no surrogatepass); a BOM refused; nesting deeper than MAX_DEPTH (64)
    containers and an integer outside +-(2^53-1) refused (F-5). Every refusal is a ValueError (W1-6)."""
    if isinstance(data, (bytes, bytearray)):
        data = bytes(data).decode("utf-8")
    _check_depth(data)
    return json.loads(data, object_pairs_hook=_no_dupes, parse_constant=_no_constant, parse_float=_finite_float, parse_int=_bounded_int)


# --- THE KEY RULE: a byte copy of requisition_aws/keys.py's (tests pin the sources equal and run the shared vectors)

_INSTANT_SHAPE = "dddd-dd-ddTdd:dd:ddZ"


def _is_instant(value):
    """Exactly ``YYYY-MM-DDTHH:MM:SSZ`` (ASCII digits only), the one spelling every verifier accepts."""
    return (isinstance(value, str) and len(value) == 20
            and all((c in "0123456789") if m == "d" else c == m for c, m in zip(value, _INSTANT_SHAPE)))


def key_standing(entry, occurred_at, accept_signers=None):
    """None when ``entry`` may be used for a record signed at ``occurred_at``, else the reason. See the module doc."""
    if accept_signers is not None and not accept_signers:
        raise ValueError("an empty accepted-signers set is a configuration error, never 'any'")
    status = entry.get("status")
    if status in ("compromised", "revoked"):
        return "key_revoked"
    if status not in ("active", "retired"):
        return "key_status_unusable"
    valid_from, valid_to = entry.get("valid_from"), entry.get("valid_to")
    if status == "retired" and valid_to is None:
        return "key_status_unusable"  # retired with no end is no standing at all
    if not _is_instant(valid_from) or (valid_to is not None and not _is_instant(valid_to)):
        return "key_window_unreadable"
    if not _is_instant(occurred_at):
        return "signed_instant_unreadable"
    if occurred_at < valid_from or (valid_to is not None and occurred_at >= valid_to):
        return "key_not_valid_at_signing"
    if accept_signers is not None and entry.get("signer") not in accept_signers:
        return "signer_not_accepted"
    return None


# --- ED25519 KEY MATERIAL (S03 review R-2): one text in keys.py, verify_chain.py, bin/lab-verify and bin/lab-log-verify ---
# edwards25519 (RFC 8032 section 5.1): p, the prime group order L, d, and sqrt(-1) = 2^((p-1)/4)
_P = 2**255 - 19
_L = 2**252 + 27742317777372353535851937790883648493
_D = -121665 * pow(121666, -1, _P) % _P
_SQRT_M1 = pow(2, (_P - 1) // 4, _P)
_IDENTITY = (0, 1)


def _decode_canonical_point(raw: bytes) -> tuple[int, int] | None:
    """RFC 8032 section 5.1.3, strictly: None for y >= p (step 1), no square root (step 3), or x = 0 with
    the sign bit set (step 4)."""
    if len(raw) != 32:
        return None
    n = int.from_bytes(raw, "little")
    sign, y = n >> 255, n & ((1 << 255) - 1)
    if y >= _P:
        return None
    x2 = (y * y - 1) * pow(_D * y * y + 1, -1, _P) % _P  # d is not a square, so d*y^2 + 1 is never 0
    x = pow(x2, (_P + 3) // 8, _P)
    if (x * x - x2) % _P:
        x = x * _SQRT_M1 % _P
    if (x * x - x2) % _P:
        return None
    if x == 0 and sign:  # x = 0 only for y = 1 or p-1, both small order: kept for RFC 8032 conformance
        return None
    if x & 1 != sign:
        x = _P - x
    return x, y


def _add(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
    """a + b by the complete twisted Edwards addition law (a = -1; RFC 8032 section 5.1.4, affine); also the doubling."""
    (x1, y1), (x2, y2) = a, b
    t = _D * x1 * x2 * y1 * y2 % _P
    return (x1 * y2 + x2 * y1) * pow(1 + t, -1, _P) % _P, (y1 * y2 + x1 * x2) * pow(1 - t, -1, _P) % _P


def _multiply(point: tuple[int, int], n: int) -> tuple[int, int]:
    result = _IDENTITY
    while n:
        if n & 1:
            result = _add(result, point)
        point = _add(point, point)
        n >>= 1
    return result


def ed25519_key_acceptable(raw: bytes) -> bool:
    """A canonical encoding (RFC 8032 5.1.3, strict) of a point of the PRIME-ORDER subgroup other than the identity:
    [L]P is the identity. That refuses the eight small-order points, every non-canonical encoding AND every mixed-order
    point (a prime-order point plus a torsion point), on which verifiers that reduce h mod L (OpenSSL) and verifiers that
    do not (verify_receipt.py) answer differently for the same signature. An honest key a*B is always prime order."""
    point = _decode_canonical_point(raw) if isinstance(raw, (bytes, bytearray)) else None
    return point is not None and point != _IDENTITY and _multiply(point, _L) == _IDENTITY


def ed25519_signature_canonical(signature: bytes) -> bool:
    """64 bytes, R a canonical point encoding (the same strict decode as a key) and S < L: the one signature encoding
    every verifier accepts (the frozen verifier alone accepts a non-canonical R)."""
    if not isinstance(signature, (bytes, bytearray)) or len(signature) != 64:
        return False
    return _decode_canonical_point(bytes(signature[:32])) is not None and int.from_bytes(signature[32:], "little") < _L


COSIGNATURE_NOTE = "co-signature present, NOT checked by this tool (use verify_offline --require-pq)"


def cosignature_line(receipt, signed):
    """G-627: the line a passing Ed25519 verdict carries when the record has, or announces, an ML-DSA-87 co-signature."""
    cosign = signed["metadata"].get("cosign")
    announced = isinstance(cosign, dict) and cosign.get("status") == "signed"
    if receipt.get("cosignature") is not None or announced:
        return COSIGNATURE_NOTE + ": this verdict covers the Ed25519 signature only\n"
    return ""


def verdict(code, message, stream, verdict_code):
    sys.stdout.flush()
    print(message + "\n\nverdict_code: " + verdict_code, file=stream)
    stream.flush()
    sys.exit(code)


def refuse(message, verdict_code):
    verdict(EXIT_REFUSED, "REFUSED (lab) -- " + message, sys.stderr, verdict_code=verdict_code)


def no_trust(message, verdict_code):
    verdict(EXIT_LAB, "TRUST NOT ESTABLISHED (lab) -- " + message, sys.stderr, verdict_code=verdict_code)


def usage(message):
    print(
        "usage: bin/lab-verify --receipt RECORD.json --registry LAB-KEYS.json --act-hash HEX\n"
        + message,
        file=sys.stderr,
    )
    sys.exit(EXIT_USAGE)


def b64(value):
    try:
        return base64.b64decode(value, validate=True)
    except Exception:
        return None


def options(argv):
    opts = {"cosignature-checked-by-caller": False}
    index = 0
    while index < len(argv):
        flag = argv[index]
        if flag == "--accept-signer":
            if index + 1 >= len(argv) or not argv[index + 1]:
                usage("%s requires a non-empty signer label: an empty accepted-signers set is a configuration error" % flag)
            opts.setdefault("accept-signer", set()).add(argv[index + 1])
            index += 2
        elif flag == "--cosignature-checked-by-caller":
            opts["cosignature-checked-by-caller"] = True
            index += 1
        elif flag in ("--receipt", "--registry", "--act-hash"):
            if index + 1 >= len(argv):
                usage("%s requires a value" % flag)
            if flag[2:] in opts:
                usage("%s given twice" % flag)
            opts[flag[2:]] = argv[index + 1]
            index += 2
        else:
            usage("unknown argument %r" % flag)
    for name in ("receipt", "registry", "act-hash"):
        if name not in opts:
            usage("--%s is required" % name)
    return opts


def run_verifier(receipt_bytes, registry_bytes):
    """The unchanged verifier over exactly the bytes this file read: (exit, stdout, stderr)."""
    if not os.path.isfile(VERIFIER):
        no_trust(
            "the unchanged verifier is not at %s, so no Ed25519 signature can be checked."
            % VERIFIER,
            verdict_code="lab_verifier_unavailable",
        )
    with tempfile.TemporaryDirectory() as scratch:
        receipt_path = os.path.join(scratch, "record.json")
        registry_path = os.path.join(scratch, "registry.json")
        with open(receipt_path, "wb") as handle:
            handle.write(receipt_bytes)
        with open(registry_path, "wb") as handle:
            handle.write(registry_bytes)
        done = subprocess.run(
            [sys.executable, "-I", VERIFIER, "--receipt", receipt_path, "--registry", registry_path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    return done.returncode, done.stdout, done.stderr


def pass_through(rc, out, err):
    """The unchanged verifier refused: its exit and its words, nothing of this file's after them."""
    sys.stdout.write(
        "bin/lab-verify: the unchanged verify_receipt.py answered exit %d; its verdict is passed "
        "through unchanged.\n" % rc
    )
    sys.stdout.flush()
    sys.stdout.buffer.write(out)
    sys.stdout.flush()
    sys.stderr.buffer.write(err)
    sys.stderr.flush()
    if rc not in (1, 2, 5, 6):
        no_trust(
            "the unchanged verifier ended with an exit it does not define (%d)." % rc,
            verdict_code="lab_verifier_unavailable",
        )
    sys.exit(rc)


def apply_key_rule(entry, key_id, payload, accept):
    """THE KEY RULE, once, for both paths and BEFORE the unedited reference verifier (F-2): a retired key without an
    end, an instant with a trailing newline or a signer outside --accept-signer are refused here, whatever the
    reference would say."""
    try:
        signed = loads_strict(payload)
    except ValueError:
        return  # an unreadable payload is refused below, check_lab_record's own code
    if not isinstance(signed, dict):
        return
    reason = key_standing(entry, signed.get("occurred_at"), accept)
    if reason is None:
        return
    allowed = "; --accept-signer allows only %s" % ", ".join('"%s"' % label for label in sorted(accept)) if accept else ""
    said = (
        'key_id %r is refused by the key rule: %s (status %r, signer "%s", window [%s, %s)%s); both paths apply the '
        "same rule." % (key_id, reason, entry.get("status"), entry.get("signer"), entry.get("valid_from"),
                         entry.get("valid_to"), allowed)
    )
    # one literal verdict_code per reason: L0-A3's census reads the keyword, never a computed code
    if reason == "key_revoked":
        no_trust(said, verdict_code="lab_key_revoked")
    elif reason == "key_status_unusable":
        no_trust(said, verdict_code="lab_key_status_not_active")
    elif reason == "key_window_unreadable":
        no_trust(said, verdict_code="lab_key_window_unreadable")
    elif reason == "signed_instant_unreadable":
        no_trust(said, verdict_code="lab_signed_instant_unreadable")
    elif reason == "key_not_valid_at_signing":
        no_trust(said, verdict_code="lab_key_not_valid_at_signing")
    else:
        no_trust(said, verdict_code="lab_signer_not_accepted")


def check_ed25519_material(entry, signature):
    """The Ed25519 KEY MATERIAL rule (S03 review R-2), judged here BEFORE the unedited reference, which reduces nothing mod L
    and accepts a non-canonical R: the key must be a canonical prime-order point, the signature's R canonical and S < L.
    What is malformed (not base64, the wrong length) is left to the reference's own words."""
    published = entry.get("public_key")
    raw_key = b64(published) if isinstance(published, str) else None
    if raw_key is not None and len(raw_key) == 32 and not ed25519_key_acceptable(raw_key):
        no_trust(
            "key_id %r publishes an Ed25519 key that is not a canonical prime-order point ([L]P is not the identity): "
            "a small-order, non-canonical or mixed-order key, on which verifiers disagree." % entry.get("key_id"),
            verdict_code="lab_key_not_prime_order",
        )
    raw_signature = b64(signature)
    if raw_signature is not None and len(raw_signature) == 64 and not ed25519_signature_canonical(raw_signature):
        refuse(
            "the signature's R is not a canonical point encoding or its S is not below L.",
            verdict_code="lab_signature_non_canonical",
        )


def check_mldsa87_entry(entry, key_id, signature):
    """The ML-DSA-87 path's own trust and form checks (the verifier's are Ed25519-only)."""
    published = entry.get("public_key")
    raw_key = b64(published) if isinstance(published, str) else None
    stated = entry.get("public_key_fingerprint")
    if raw_key is None or not isinstance(stated, str) or hashlib.sha256(raw_key).hexdigest() != stated:
        no_trust(
            "key_id %r does not hash to its own published fingerprint (sha256 of the raw key, "
            "lower-case hex), so nothing the entry states can be relied on." % key_id,
            verdict_code="lab_key_fingerprint_mismatch",
        )
    if len(raw_key) != MLDSA87_PUBLIC_BYTES:
        no_trust(
            "key_id %r publishes a %d-byte key; an ML-DSA-87 public key is %d bytes."
            % (key_id, len(raw_key), MLDSA87_PUBLIC_BYTES),
            verdict_code="lab_key_public_key_malformed",
        )
    raw_signature = b64(signature)
    if raw_signature is None or len(raw_signature) != MLDSA87_SIGNATURE_BYTES:
        refuse(
            "the signature is not base64 of %d bytes, the form of an ML-DSA-87 signature (its "
            "validity is not checked here)." % MLDSA87_SIGNATURE_BYTES,
            verdict_code="lab_signature_malformed",
        )


def check_kms_key(metadata, key_id, entry):
    """Step 7 for a record that signs signer kms (K1): a KMS entry, a KMS key id, its own ARN."""
    prefix = KMS_KEY_ID_PREFIX.get(entry.get("algorithm"))
    if (
        entry.get("signer") != KMS_SIGNER
        or prefix is None
        or not key_id.startswith(prefix)
        or len(key_id) == len(prefix)
    ):
        refuse(
            "the record signs signer kms, but key_id %r is not a lab KMS key: its key file entry "
            "must say signer kms and its id must be %s<the KMS key's resource id>."
            % (key_id, prefix or "requisition_lab_kms_<algorithm>_"),
            verdict_code="lab_kms_key_not_kms",
        )
    arn = metadata.get("kms_key_arn")
    resource = key_id[len(prefix):]
    if (
        not isinstance(arn, str)
        or not arn.startswith("arn:")
        or arn.split(":")[2:3] != ["kms"]
        or not arn.endswith(":key/" + resource)
    ):
        refuse(
            "the signed metadata.kms_key_arn %r is not the ARN of the KMS key key_id %r names "
            "(key/%s)." % (arn, key_id, resource),
            verdict_code="lab_kms_key_arn_mismatch",
        )


def check_lab_record(payload, key_id, act_hash, entry):
    """Steps 5 to 8 of the module docstring, over the signed bytes."""
    try:
        signed = loads_strict(payload)
    except ValueError:
        signed = None
    if not isinstance(signed, dict):
        refuse("the signed payload is not a strict JSON object.", verdict_code="lab_signed_payload_unreadable")

    receipt_type = signed.get("receipt_type")
    lab_kind = isinstance(receipt_type, str) and receipt_type.startswith(LAB_KIND_PREFIX)
    effector_kind = (
        signed.get("subject_type") == "effector"
        and isinstance(signed.get("metadata"), dict)
        and signed["metadata"].get("record_kind") == EFFECTOR_RECORD_KIND
    )
    if not (lab_kind or effector_kind):
        refuse(
            "the signed receipt_type %r is not a lab kind (%s...), nor an effector allow whose "
            "metadata.record_kind is %s." % (receipt_type, LAB_KIND_PREFIX, EFFECTOR_RECORD_KIND),
            verdict_code="lab_record_kind_not_lab",
        )

    metadata = signed.get("metadata")
    if not isinstance(metadata, dict):
        refuse("the signed bytes carry no metadata object.", verdict_code="lab_label_missing")
    kms = metadata.get("signer") == KMS_SIGNER
    expected = dict(LABELS, signer=KMS_SIGNER) if kms else LABELS
    missing = sorted(name for name, value in expected.items() if metadata.get(name) != value)
    if missing:
        refuse(
            "the signed metadata lacks the lab label(s) %s (the publisher Decision 11e17a20 requires "
            "profile lab, signer dev (or kms, K1), n6_profile not_followed and hands one-person "
            "(G-301))." % ", ".join(missing),
            verdict_code="lab_label_missing",
        )

    if metadata.get("key_id") != key_id:
        refuse(
            "the signed metadata.key_id %r is not the envelope's key_id %r (L0-D5)."
            % (metadata.get("key_id"), key_id),
            verdict_code="lab_key_id_mismatch",
        )
    if kms:
        check_kms_key(metadata, key_id, entry)
    elif key_id not in DEV_KEY_IDS.values():
        refuse(
            "key_id %r is not a lab dev key (%s)." % (key_id, ", ".join(sorted(DEV_KEY_IDS.values()))),
            verdict_code="lab_key_not_dev",
        )

    # REQ-189 (R2-4, its GAP R189-W7 as the reds read it): a record-only act (a CEASE) binds its
    # display's digest and no act hash; --act-hash names that digest.
    if metadata.get("verdict") == "recorded_no_authority":
        if metadata.get("display_digest") != act_hash:
            refuse(
                "the CEASE record binds display digest %s, not the --act-hash given (%s)."
                % (metadata.get("display_digest"), act_hash),
                verdict_code="lab_act_hash_mismatch",
            )
        return signed

    signed_act_hash = metadata.get("act_hash")
    # REQ-189 (R4-3): an ARM or ENGAGE allow binds its act in payload_hash (the consumer's field)
    if not isinstance(signed_act_hash, str) and signed.get("subject_type") == "effector":
        signed_act_hash = signed.get("payload_hash")
    if not isinstance(signed_act_hash, str):
        refuse(
            "the signed metadata binds no act hash: only a lab statement or decision binds an act.",
            verdict_code="lab_act_hash_absent",
        )
    if signed_act_hash != act_hash:
        refuse(
            "the record is bound to act hash %s, not the --act-hash given (%s)."
            % (signed_act_hash, act_hash),
            verdict_code="lab_act_hash_mismatch",
        )
    return signed


def signed_verdict(signed):
    """The record's signed verdict, said on every path that exits 5 for a record that passed (the L0
    build review's B10): the exit judges the record's integrity, never whether it allows."""
    verdict = signed["metadata"].get("verdict")
    if isinstance(verdict, str):
        return "signed verdict: %s (the record's own; the exit code does not tell an allow from a deny)" % verdict
    return "signed verdict: none (a %s, not a decision)" % signed.get("receipt_type", "record")


def main(argv):
    opts = options(argv)
    accept = opts.get("accept-signer")  # None: any signer; else the set of accepted signer labels
    try:
        with open(opts["receipt"], "rb") as handle:
            receipt_bytes = handle.read()
        with open(opts["registry"], "rb") as handle:
            registry_bytes = handle.read()
        receipt = loads_strict(receipt_bytes)
        registry = loads_strict(registry_bytes)
    except (OSError, ValueError) as error:
        usage("cannot read input: %s" % error)

    if not isinstance(receipt, dict) or not all(isinstance(receipt.get(f), str) for f in ENVELOPE):
        usage("the record must be a JSON object carrying the four strings %s" % ", ".join(ENVELOPE))
    payload, signature, key_id = receipt["signed_payload"], receipt["signature"], receipt["key_id"]

    entries = registry.get("entries") if isinstance(registry, dict) else None
    matches = [e for e in entries if isinstance(e, dict) and e.get("key_id") == key_id] if isinstance(entries, list) else []
    if len(matches) != 1:
        # no entry, two entries or no entries list: the unchanged verifier's trust questions
        rc, out, err = run_verifier(receipt_bytes, registry_bytes)
        if rc != 0:
            pass_through(rc, out, err)
        no_trust(
            "the lab key file does not name key_id %r exactly once, yet the unchanged verifier "
            "answered exit 0." % key_id,
            verdict_code="lab_verifier_unavailable",
        )
    entry = matches[0]

    algorithm = entry.get("algorithm")
    if algorithm not in DEV_KEY_IDS:
        refuse(
            "the lab key file's entry for key_id %r names algorithm %r; this verifier knows "
            "ed25519 and mldsa87 only, and an entry without one is refused (default deny)."
            % (key_id, algorithm),
            verdict_code="lab_key_algorithm_unknown",
        )

    if hashlib.sha256(payload.encode("utf-8")).hexdigest() != receipt["receipt_hash"]:
        refuse(
            "receipt_hash is not the SHA-256 of signed_payload: the record's bytes are not the "
            "bytes it states.",
            verdict_code="lab_receipt_hash_mismatch",
        )

    apply_key_rule(entry, key_id, payload, accept)
    if algorithm == "ed25519":
        check_ed25519_material(entry, receipt["signature"])

    if algorithm == "ed25519":
        rc, out, err = run_verifier(receipt_bytes, registry_bytes)
        if rc != 0:
            pass_through(rc, out, err)
        signed = check_lab_record(payload, key_id, opts["act-hash"], entry)
        kms = signed["metadata"].get("signer") == KMS_SIGNER
        cosig = "" if opts["cosignature-checked-by-caller"] else cosignature_line(receipt, signed)
        if signed["metadata"].get("verdict") == "recorded_no_authority":
            print(
                "the unchanged verify_receipt.py: exit 0 (the Ed25519 signature and the receipt hash "
                "check out under key_id %r in the key file given).\n"
                "the lab checks: kind, labels, key id and the display digest bound.\n%s\n"
                "RECORDED (no authority): a record-only act (a CEASE), signed by %s; it "
                "authorises nothing.\n\nverdict_code: lab_recorded_no_authority"
                % (key_id, cosig, kms_degraded(signed) if kms else "the lab's dev key")
            )
            sys.exit(EXIT_RECORDED)
        head = (
            "the unchanged verify_receipt.py: exit 0 (the Ed25519 signature and the receipt hash "
            "check out under key_id %r in the key file given).\n"
            "the lab checks: kind, labels, key id and act hash bound.\n%s\n%s\n" % (key_id, signed_verdict(signed), cosig)
        )
        if kms:
            print(head + kms_degraded(signed) + "\n\nverdict_code: lab_kms_key")
        else:
            print(head + DEGRADED_ED25519 + "\n\nverdict_code: lab_dev_key")
        sys.exit(EXIT_LAB)

    check_mldsa87_entry(entry, key_id, signature)
    signed = check_lab_record(payload, key_id, opts["act-hash"], entry)
    kms_note = (
        "\n" + kms_degraded(signed, " by mix requisition.lab.verify_mldsa87 (not by this verifier)")
        if signed["metadata"].get("signer") == KMS_SIGNER
        else ""
    )
    print(
        "the record's bytes, binding and labels check out under key_id %r: receipt hash, kind, "
        "labels, key id and act hash.\n%s\nits signature is checked by: mix requisition.lab.verify_mldsa87 "
        "ENVELOPE --keys LAB-KEYS.json\n\n%s\n\nverdict_code: lab_signature_unchecked_mldsa87"
        % (key_id, signed_verdict(signed), DEGRADED_MLDSA87 + kms_note)
    )
    sys.exit(EXIT_LAB)


if __name__ == "__main__":
    main(sys.argv[1:])
